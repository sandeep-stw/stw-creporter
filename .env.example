# Copy to .env and fill in real values. Do not commit .env.
# Entra setup: docs/entra-app.md (or scripts/Register-EntraApp.ps1)
# Token: pwsh -File scripts/Get-BCAccessToken.ps1

# Auth.js session encryption (generate with: openssl rand -base64 32)
AUTH_SECRET=

# Public origin used by Auth.js (no trailing slash)
AUTH_URL=http://localhost:3000

# Microsoft Entra application (same app registration as Business Central API access)
AUTH_MICROSOFT_ENTRA_ID_ID=00000000-0000-0000-0000-000000000000
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# For a single-tenant app: https://login.microsoftonline.com/{tenantId}/v2.0
# For multi-tenant SaaS (work accounts): https://login.microsoftonline.com/organizations/v2.0
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/organizations/v2.0

# Directory (tenant) ID of the Entra tenant that owns the app registration
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000

# Business Central OAuth (confidential client — never sent to the browser)
BC_TENANT_ID=00000000-0000-0000-0000-000000000000
BC_ENVIRONMENT_NAME=sandbox
BC_CLIENT_ID=00000000-0000-0000-0000-000000000000
BC_CLIENT_SECRET=
BC_API_BASE_URL=https://api.businesscentral.dynamics.com/v2.0/00000000-0000-0000-0000-000000000000/sandbox
BC_TOKEN_SCOPE=https://api.businesscentral.dynamics.com/.default

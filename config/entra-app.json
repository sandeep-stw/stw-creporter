{
  "displayName": "Executive Intelligence Agent",
  "description": "Confidential client for Auth.js Microsoft Entra sign-in and Business Central API access.",
  "signInAudience": "AzureADMultipleOrgs",
  "webRedirectUris": [
    "http://localhost:3000/api/auth/callback/microsoft-entra-id",
    "https://businesscentral.dynamics.com/OAuthLanding.htm"
  ],
  "microsoftGraph": {
    "displayName": "Microsoft Graph",
    "resourceAppId": "00000003-0000-0000-c000-000000000000",
    "delegatedPermissions": [
      {
        "value": "openid",
        "id": "37f7f235-527c-4136-accd-4a02d1972968",
        "type": "Scope",
        "purpose": "Sign users in (OIDC)."
      },
      {
        "value": "profile",
        "id": "14dad69e-099b-42c9-810b-d002981feec1",
        "type": "Scope",
        "purpose": "Read basic profile claims."
      },
      {
        "value": "email",
        "id": "64a6cdd6-aab1-4aaf-94b8-3cc8405e90d0",
        "type": "Scope",
        "purpose": "Read the user's email address."
      },
      {
        "value": "offline_access",
        "id": "7427e0e9-2fba-42fe-b0c0-848c9e6a3102",
        "type": "Scope",
        "purpose": "Refresh tokens for BC delegated access."
      },
      {
        "value": "User.Read",
        "id": "e1fe6dd8-ba31-4d61-89e7-88639da4683d",
        "type": "Scope",
        "purpose": "Read the signed-in user (Auth.js Microsoft Entra ID provider)."
      }
    ]
  },
  "businessCentralResource": {
    "displayName": "Dynamics 365 Business Central",
    "resourceAppId": "996def3d-b36c-4153-8607-a6fd3c01b89f",
    "tokenScope": "https://api.businesscentral.dynamics.com/.default"
  },
  "applicationPermissions": [
    {
      "value": "API.ReadWrite.All",
      "id": "a42b0b75-311e-488d-b67e-8fe84f924341",
      "type": "Role",
      "purpose": "Access Business Central APIs and web services (v2.0 and custom APIs)."
    },
    {
      "value": "Automation.ReadWrite.All",
      "id": "d365bc00-a990-0000-00bc-160000000001",
      "type": "Role",
      "purpose": "Access Business Central automation APIs when company setup is required."
    }
  ],
  "delegatedPermissions": [
    {
      "value": "Financials.ReadWrite.All",
      "id": "2fb13c28-9d89-417f-9af2-ec3065bc16e6",
      "type": "Scope",
      "purpose": "Access Business Central as the signed-in user (owner onboarding / refresh tokens)."
    }
  ],
  "clientSecret": {
    "displayName": "executive-intelligence-agent",
    "defaultValidityMonths": 24
  },
  "businessCentralApplicationCard": {
    "state": "Enabled",
    "recommendedPermissionSets": [
      "D365 AUTOMATION",
      "D365 BUS FULL ACCESS"
    ],
    "notes": [
      "Do not assign the SUPER permission set to an Entra application.",
      "Grant Consent from the Microsoft Entra Applications card if admin consent was not granted in Entra.",
      "Map Application (client) ID into AUTH_MICROSOFT_ENTRA_ID_ID and BC_CLIENT_ID."
    ]
  },
  "envMapping": {
    "AUTH_MICROSOFT_ENTRA_ID_ID": "Application (client) ID",
    "AUTH_MICROSOFT_ENTRA_ID_SECRET": "Client secret Value shown once at creation time",
    "AUTH_MICROSOFT_ENTRA_ID_ISSUER": "https://login.microsoftonline.com/organizations/v2.0 (multi-tenant work accounts)",
    "ENTRA_TENANT_ID": "Directory (tenant) ID of the app's home tenant",
    "BC_CLIENT_ID": "Same Application (client) ID",
    "BC_CLIENT_SECRET": "Same client secret value",
    "BC_TOKEN_SCOPE": "https://api.businesscentral.dynamics.com/.default"
  },
  "references": [
    "https://learn.microsoft.com/en-us/dynamics365/business-central/dev-itpro/administration/automation-apis-using-s2s-authentication",
    "https://learn.microsoft.com/en-us/entra/identity-platform/quickstart-register-app",
    "https://authjs.dev/getting-started/providers/microsoft-entra-id"
  ]
}
